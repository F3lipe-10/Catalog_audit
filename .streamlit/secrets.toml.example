# ==============================================================================
# ARCHIVO DE SECRETOS - .streamlit/secrets.toml
# ==============================================================================
# ⚠️ NO SUBAS ESTE ARCHIVO A GITHUB. Está incluido en .gitignore.
#
# Para generar el hash de contraseña ejecuta:
#    python generar_hash.py
# y pega el resultado en el campo "password" de cada usuario.
#
# Para conseguir API key gratuita de Gemini:
#    https://aistudio.google.com/app/apikey
# ==============================================================================

# ----- Configuración de cookie de sesión -----
[cookie]
name = "catalogo_auth"
# ⚠️ Cambia esta key por una cadena aleatoria larga (puedes generar una en
# https://www.uuidgenerator.net/ o con: python -c "import secrets; print(secrets.token_hex(32))")
key = "CAMBIA_ESTA_CLAVE_ALEATORIA_LARGA_Y_SECRETA_123456"
expiry_days = 7

# ----- Credenciales de usuarios -----
# Agrega un bloque [credentials.usernames.NOMBRE_USUARIO] por cada usuario.
# El "password" debe ser un hash bcrypt (usa generar_hash.py).

[credentials.usernames.admin]
email = "admin@empresa.com"
name = "Administrador"
password = "$2b$12$REEMPLAZA_ESTE_HASH_CON_EL_GENERADO_POR_generar_hash"

[credentials.usernames.juan]
email = "juan@empresa.com"
name = "Juan Pérez"
password = "$2b$12$OTRO_HASH_GENERADO_POR_generar_hash_PEGAR_AQUI"

# ----- API Key de DeepSeek -----
[deepseek]
api_key = "TU_API_KEY_DE_DEEPSEEK_AQUI"

# ----- Conexión a base de datos PostgreSQL (Supabase u otro) -----
# Crea un proyecto en https://supabase.com → Settings → Database → Connection string
# Usa la URI de "Transaction" o "Session" mode (puerto 5432 o 6543).
# ⚠️ Reemplaza [YOUR-PASSWORD] con tu contraseña real.
[connections.db]
url = "postgresql://postgres.XXXXXXXX:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
